
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Evolución Académica AI platform, with distinct roles and access privileges.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roles": { 
          "type": "array", 
          "items": { "type": "string", "enum": ["alumno", "mentor", "admin", "marketing"] },
          "description": "Array of roles assigned to the user."
        },
        "mentorPermissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Granular permissions for mentor role (academic_management, mentor_challenges, students_view, followups_management)."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "roles", "createdAt", "updatedAt"]
    },
    "SalesPage": {
      "title": "SalesPage",
      "type": "object",
      "description": "A standalone public landing page generated by merging a course with a template collection.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "mentorId": { "type": "string" },
        "courseId": { "type": "string" },
        "price": { "type": "number", "description": "Dynamic price for this content pack." },
        "templateCollectionId": { "type": "string" },
        "aiContent": { "type": "object" },
        "exportUrls": { 
          "type": "object",
          "properties": {
            "emailsExportUrl": { "type": "string" },
            "socialExportUrl": { "type": "string" },
            "adsExportUrl": { "type": "string" }
          }
        },
        "branding": { "type": "object" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mentorId", "courseId", "templateCollectionId"]
    },
    "Campaign": {
      "title": "Campaign",
      "type": "object",
      "description": "A live marketing campaign that fills a template collection with specific course content.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "mentorId": { "type": "string" },
        "salesPageId": { "type": "string" },
        "courseId": { "type": "string" },
        "strategy": { "type": "object" },
        "startDate": { "type": "string", "format": "date" },
        "autoPilot": { "type": "boolean" },
        "executionLogs": { "type": "array", "items": { "type": "object" } },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TemplateCollection": {
      "title": "TemplateCollection",
      "type": "object",
      "description": "A grouped collection of marketing templates generated from a single campaign directive (blueprints).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "directives": { "type": "string" },
        "ownerId": { "type": "string" },
        "assets": {
          "type": "object",
          "properties": {
            "landings": { "type": "array", "items": { "type": "object" } },
            "emails": { "type": "array", "items": { "type": "object" } },
            "socials": { "type": "array", "items": { "type": "object" } },
            "ads": { "type": "array", "items": { "type": "object" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles."
        }
      },
      {
        "path": "/salesPages/{pageId}",
        "definition": {
          "entityName": "SalesPage",
          "schema": { "$ref": "#/backend/entities/SalesPage" },
          "description": "Public sales landing pages."
        }
      },
      {
        "path": "/campaigns/{campaignId}",
        "definition": {
          "entityName": "Campaign",
          "schema": { "$ref": "#/backend/entities/Campaign" },
          "description": "Marketing execution campaigns."
        }
      },
      {
        "path": "/templateCollections/{collectionId}",
        "definition": {
          "entityName": "TemplateCollection",
          "schema": { "$ref": "#/backend/entities/TemplateCollection" },
          "description": "Blueprints for marketing assets."
        }
      }
    ]
  }
}
