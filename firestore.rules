
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // CONFIGURACIÓN GLOBAL (Pública para que el Dashboard no falle)
    match /config/{configId=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'felizdeemprender@gmail.com' ||
        request.auth.token.email == 'btouchacademy@gmail.com' ||
        request.auth.token.email == 'btechacademy.ai@gmail.com' ||
        request.auth.token.email == 'tutor.felizdeemprender@gmail.com'
      );
    }


    function isSignedIn() {
      return request.auth != null;
    }

    // FUNCIÓN SEGURA: Solo intenta leer si el documento existe
    function getUserRoles() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.get('roles', []) : [];
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'felizdeemprender@gmail.com' ||
        request.auth.token.email == 'btouchacademy@gmail.com' ||
        request.auth.token.email == 'btechacademy.ai@gmail.com' ||
        request.auth.token.email == 'tutor.felizdeemprender@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) ||
        'admin' in getUserRoles()
      );
    }

    function isMentor() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_mentor/$(request.auth.uid)) ||
        'mentor' in getUserRoles()
      );
    }

    function isMarketing() {
      return isSignedIn() && 'marketing' in getUserRoles();
    }


    // Regla global para consultas de grupo (Collection Group) en desafíos
    match /{path=**}/individualTasks/{taskId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && (isMentor() || isAdmin());
      allow update, delete: if isSignedIn() && (
        isAdmin() || 
        resource.data.mentorId == request.auth.uid || 
        resource.data.studentId == request.auth.uid ||
        resource.data.get('studentEmail', '').lower() == request.auth.token.email.lower()
      );
    }

    match /salesPages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || isMarketing() || isMentor();
    }

    match /leads/{leadId} {
      allow read: if true; // Public for viewing conversions or mentor calculating stats
      allow write: if true; // Public to capture leads from landing pages
    }

    match /mail/{mailId} {
      // Los emails se encolan exclusivamente desde el servidor (Admin SDK via Server Actions / API Routes).
      // El cliente nunca escribe directamente en esta colección.
      allow create: if false;
      allow read, update, delete: if false;
    }


    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAdmin() || isMentor();
      allow update: if isAdmin() || (isMentor() && resource.data.mentorId == request.auth.uid);
      allow delete: if isAdmin() || (isMentor() && resource.data.mentorId == request.auth.uid);

      match /lessons/{lessonId} {
        allow read: if true;
        allow write: if isAdmin() || (isMentor() && get(/databases/$(database)/documents/courses/$(courseId)).data.mentorId == request.auth.uid);
      }

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isAdmin() || (isMentor() && get(/databases/$(database)/documents/courses/$(courseId)).data.mentorId == request.auth.uid);
        
        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if isAdmin() || (isMentor() && get(/databases/$(database)/documents/courses/$(courseId)).data.mentorId == request.auth.uid);
        }
      }
    }

    match /enrollments/{enrollmentId} {
      allow read, list: if isSignedIn() && (
        request.auth.uid == resource.data.studentId || 
        ("inviteEmail" in resource.data && resource.data.inviteEmail == request.auth.token.email) ||
        isAdmin() || 
        isMentor() ||
        (exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) && 
         get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.mentorId == request.auth.uid)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || 
        ("inviteEmail" in resource.data && resource.data.inviteEmail == request.auth.token.email) ||
        isAdmin() || 
        (exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) && 
         get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.mentorId == request.auth.uid)
      );
      allow delete: if isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/courses/$(resource.data.courseId)) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.mentorId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() ||
        // Mentors can pre-register students who don't have an account yet
        (isMentor() && request.resource.data.get('createdVia', '') == 'manual_enrollment')
      );
      allow update: if isSignedIn() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (resource.data.get('email', '').lower() == request.auth.token.email.lower()) ||
        // Mentors can only ADD roles to other users (never remove), ensuring no privilege escalation
        (isMentor() && 
          request.resource.data.get('roles', []).hasAll(resource.data.get('roles', []))
        )
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('email', '').lower() == request.auth.token.email.lower());

      match /private/config {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /paymentMethods/{methodId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /studentNotes/{noteId} {
        allow read, list: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMentor());
        allow create: if isSignedIn() && (isMentor() || isAdmin());
        allow update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /individualTasks/{taskId} {
        allow read, list: if isSignedIn();
      }
    }

    match /followups/{followUpId} {
      allow read, list: if isSignedIn() && (isAdmin() || isMentor() || resource.data.studentId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || isMentor());

      match /sessions/{sessionId} {
        allow read, list: if isSignedIn() && (isAdmin() || isMentor() || get(/databases/$(database)/documents/followups/$(followUpId)).data.studentId == request.auth.uid);
        allow write: if isSignedIn() && (isAdmin() || isMentor());
      }

      match /tasks/{taskId} {
        allow read, list: if isSignedIn() && (isAdmin() || isMentor() || get(/databases/$(database)/documents/followups/$(followUpId)).data.studentId == request.auth.uid);
        allow write: if isSignedIn() && (isAdmin() || isMentor());
      }
    }

    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ai_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Solo el Servidor (Admin SDK) puede escribir
    }

    match /ai_quotas/{quotaId} {
      allow read: if isSignedIn() && (request.auth.uid == quotaId || isAdmin());
      allow write: if isAdmin();
    }

    match /templateCollections/{collectionId} {
      allow read: if isSignedIn() && (isAdmin() || isMentor());
      allow write: if isAdmin();
    }

    match /landingStyles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    match /campaigns/{campaignId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.mentorId == request.auth.uid);
      allow write: if isSignedIn() && (isAdmin() || isMentor());
    }

    match /moderation-logs/{logId} {
      allow read: if isAdmin() || isMentor();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Intentos de evaluación de quiz (logs inmutables)
    match /quiz_attempts/{attemptId} {
      allow read: if isSignedIn() && (isAdmin() || isMentor() || resource.data.studentId == request.auth.uid);
      allow create: if isSignedIn(); // Alumnos y tutores pueden registrar intentos
      allow update, delete: if isAdmin(); // Solo admin puede modificar
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /roles_admin/{userId} { allow get: if isSignedIn(); allow list, write: if isAdmin(); }
    match /roles_mentor/{userId} { allow get: if isSignedIn(); allow list, write: if isAdmin(); }

    // Mentors store their influencer relationships in their own subcollection
    match /mentorInfluencers/{mentorId} {
      allow read: if isSignedIn() && (request.auth.uid == mentorId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == mentorId || isAdmin());

      match /referidos/{referidoId} {
        allow read: if isSignedIn() && (request.auth.uid == mentorId || isAdmin());
        allow write: if isSignedIn() && (request.auth.uid == mentorId || isAdmin());
      }
    }

    // Órdenes de pago por transferencia bancaria
    // El backend (Admin SDK) crea los documentos; solo el mentor dueño puede leerlos.
    match /transferOrders/{orderId} {
      allow read, list: if isSignedIn() && (
        resource.data.mentorId == request.auth.uid || isAdmin()
      );
      // Solo el backend (Admin SDK) puede crear/actualizar — el cliente no escribe directamente.
      allow write: if false;
    }
  }
}
