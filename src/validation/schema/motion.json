{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADN Motion Module",
  "type": "object",
  "required": ["camera", "transitions"],
  "properties": {
    "camera": {
      "type": "object",
      "required": ["segment_rules"],
      "properties": {
        "definitions": { "type": "object" },
        "modes": { "type": "object" },
        "segment_rules": {
          "type": "object",
          "patternProperties": {
            "^[A-Z_]+$": {
              "type": "object",
              "required": ["mode"],
              "properties": {
                "mode": { "type": "string" },
                "intensity": { "type": "number", "minimum": 0.1, "maximum": 5 },
                "speed": { "type": "number", "minimum": 0, "maximum": 5 },
                "direction": { "type": "string", "enum": ["in", "out", "left", "right", "center", "top", "bottom"] },
                "transition": { "type": ["string", "null"], "pattern": "^xfade:.*$" },
                "transition_duration": { "type": ["number", "null"], "minimum": 0, "maximum": 2 }
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "object",
      "required": ["default", "duration"],
      "properties": {
        "default": { 
          "type": "string",
          "pattern": "^xfade:(fade|wipeleft|wiperight|wipedown|wipeup|slideleft|slideright|circleopen|dissolve)$"
        },
        "duration": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    }
  }
}
