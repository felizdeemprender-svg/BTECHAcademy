{
  "camera": {
    "modes": {
      "zoom": {
        "description": "Zoom impacto",
        "default_intensity": 1.6,
        "default_speed": 4,
        "direction": "center"
      },
      "pan": {
        "description": "Paneo rápido",
        "default_intensity": 1.1,
        "default_speed": 6,
        "direction": "center"
      },
      "static": {
        "description": "Sin movimiento",
        "default_intensity": 1,
        "default_speed": 0,
        "direction": "center"
      }
    },
    "segment_rules": {
      "GANCHO": {
        "mode": "zoom",
        "intensity": 1.7,
        "speed": 5,
        "direction": "center",
        "transition": "xfade:circleopen",
        "transition_duration": 0.4
      },
      "VALOR": {
        "mode": "pan",
        "intensity": 1.15,
        "speed": 4,
        "direction": "center",
        "transition": "xfade:wipeleft",
        "transition_duration": 0.3
      },
      "CTA": {
        "mode": "zoom",
        "intensity": 1.9,
        "speed": 5,
        "direction": "center",
        "transition": "xfade:circleopen",
        "transition_duration": 0.5
      },
      "CIERRE": {
        "mode": "static",
        "intensity": 1,
        "speed": 0,
        "direction": "center",
        "transition": "xfade:fade",
        "transition_duration": 1
      }
    }
  },
  "transitions": {
    "default": "xfade:circleopen",
    "duration": 0.4
  }
}