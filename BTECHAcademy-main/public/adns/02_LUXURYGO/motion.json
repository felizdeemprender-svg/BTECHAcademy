{
  "camera": {
    "modes": {
      "zoom": {
        "description": "Zoom premium ultra-lento",
        "default_intensity": 1.12,
        "default_speed": 0.1,
        "direction": "center"
      },
      "pan": {
        "description": "Paneo de seda",
        "default_intensity": 1.05,
        "default_speed": 0.1,
        "direction": "left"
      }
    },
    "segment_rules": {
      "GANCHO": {
        "mode": "zoom",
        "intensity": 1.15,
        "speed": 0.15,
        "direction": "center",
        "transition": "xfade:dissolve",
        "transition_duration": 1.2
      },
      "VALOR": {
        "mode": "pan",
        "intensity": 1.05,
        "speed": 0.1,
        "direction": "left",
        "transition": "xfade:fade",
        "transition_duration": 1
      },
      "CTA": {
        "mode": "zoom",
        "intensity": 1.18,
        "speed": 0.2,
        "direction": "center",
        "transition": "xfade:dissolve",
        "transition_duration": 1.5
      },
      "CIERRE": {
        "mode": "static",
        "intensity": 1,
        "speed": 0,
        "direction": "center",
        "transition": "xfade:fade",
        "transition_duration": 2
      }
    }
  },
  "transitions": {
    "default": "xfade:fade",
    "duration": 1.2
  }
}