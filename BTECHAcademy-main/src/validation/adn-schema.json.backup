{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADN Schema",
  "description": "Schema for validating ADN (Audio-Visual DNA) files",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{2}_[A-Z0-9_]+$",
      "description": "Unique identifier for the ADN"
    },
    "version": {
      "type": "string",
      "enum": ["1.0", "2.0"],
      "description": "ADN version"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Display name of the ADN"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Description of the ADN"
    },
    "composition": {
      "type": "object",
      "properties": {
        "safe_areas": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "bottom": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "sides": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            }
          },
          "required": ["top", "bottom", "sides"]
        },
        "global_filters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": ["curves", "vignette", "unsharp", "noise", "brightness", "contrast"]
              },
              "params": {
                "type": "string"
              }
            },
            "required": ["name", "params"]
          }
        }
      },
      "required": ["safe_areas", "global_filters"]
    },
    "audio_settings": {
      "type": "object",
      "properties": {
        "background_music_url": {
          "type": "string"
        },
        "voice_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "music_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "typography_engine": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "string",
          "enum": ["drawtext", "libass"]
        },
        "master_styles": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z_]+$": {
              "type": "object",
              "properties": {
                "fontName": {
                  "type": "string",
                  "pattern": "^[^\\s]+\\.(ttf|otf)$"
                },
                "fontSize": {
                  "type": "number",
                  "minimum": 10,
                  "maximum": 200
                },
                "primaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "alignment": {
                  "type": "string",
                  "enum": ["left", "center", "right"]
                },
                "uppercase": {
                  "type": "boolean"
                },
                "animation": {
                  "type": "string",
                  "enum": ["pop", "fade_in", "slide_in", "bounce", "kinetic_pop", "static", "fade_to_black", "karaoke", "explosive", "rapid_fade"]
                },
                "shadowDepth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 20
                },
                "shadowColor": {
                  "type": "string",
                  "pattern": "^0x[0-9A-Fa-f]{6}@[0-9.]+$"
                }
              },
              "required": ["fontName", "fontSize", "primaryColor", "alignment"],
              "additionalProperties": false
            }
          }
        }
      },
      "required": ["renderer", "master_styles"],
      "additionalProperties": false
    },
    "motion_engine": {
      "type": "object",
      "properties": {
        "camera": {
          "type": "object",
          "properties": {
            "modes": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]+$": {
                  "type": "string"
                }
              }
            }
          },
          "required": ["modes"]
        },
        "transitions": {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            },
            "duration": {
              "type": "string",
              "default": "0.5"
            }
          },
          "patternProperties": {
            "^[A-Z]+$": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["camera", "transitions"],
      "additionalProperties": false
    },
    "logic_segments": {
      "type": "object",
      "patternProperties": {
        "^[A-Z_]+$": {
          "type": "object",
          "properties": {
            "camera": {
              "type": "string"
            },
            "style": {
              "type": "string"
            },
            "overlay": {
              "type": ["string", "null"]
            },
            "duration_multiplier": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            }
          },
          "required": ["camera", "style", "overlay", "duration_multiplier"],
          "additionalProperties": false
        }
      },
      "required": ["GANCHO", "VALOR", "CTA", "CIERRE"],
      "additionalProperties": false
    },
    "audio_engine": {
      "type": "object",
      "properties": {
        "voice_id": {
          "type": "string"
        },
        "mastering": {
          "type": "string"
        },
        "sidechain": {
          "type": "object",
          "properties": {
            "threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ratio": {
              "type": "number",
              "minimum": 1,
              "maximum": 50
            },
            "attack": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "release": {
              "type": "number",
              "minimum": 0,
              "maximum": 2000
            }
          },
          "required": ["threshold", "ratio", "attack", "release"]
        },
        "voice_fx": {
          "type": "string"
        },
        "music_fx": {
          "type": "string"
        }
      },
      "required": ["voice_id", "mastering"],
      "additionalProperties": false
    },
    "formats": {
      "type": "object",
      "patternProperties": {
        "^(vertical|portrait|square|horizontal)$": {
          "type": "object",
          "properties": {
            "resolution": {
              "type": "string",
              "enum": ["9:16", "4:5", "1:1", "16:9"]
            },
            "global_fx": {
              "type": "object",
              "properties": {
                "voiceId": {
                  "type": "string",
                  "description": "ID del modelo de voz"
                },
                "audioMastering_base": {
                  "type": "string",
                  "description": "Base de audio mastering"
                },
                "lut3d": {
                  "type": "string",
                  "description": "LUT de color grading"
                },
                "curves_preset": {
                  "type": "string",
                  "enum": ["none", "color_negative", "cross_process", "older", "vintage", "luma", "chroma", "vibrant", "skin_tones", "cool", "warm"],
                  "description": "Preset de curves para color grading"
                },
                "curves_master": {
                  "type": "string",
                  "description": "Curva master personalizada (ej: '0/0 0.5/0.5 1/1')"
                },
                "curves_red": {
                  "type": "string",
                  "description": "Curva roja personalizada"
                },
                "curves_green": {
                  "type": "string",
                  "description": "Curva verde personalizada"
                },
                "curves_blue": {
                  "type": "string",
                  "description": "Curva azul personalizada"
                },
                "vignette_intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Intensidad de viñeta"
                },
                "sharpen": {
                  "type": "boolean",
                  "description": "Aplicar sharpen"
                },
                "safe_area_protection": {
                  "type": "boolean",
                  "description": "Proteger áreas seguras"
                },
                "platform_target": {
                  "type": "string",
                  "enum": ["youtube", "instagram", "tiktok", "youtube_shorts"],
                  "description": "Plataforma objetivo"
                },
                "zoom_intensity": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 3.0,
                  "description": "Intensidad de zoom"
                },
                "zoom_speed": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5.0,
                  "description": "Velocidad de zoom"
                },
                "zoom_direction": {
                  "type": "string",
                  "enum": ["center", "left", "right", "up", "down"],
                  "description": "Dirección del zoom"
                },
                "sharpen_intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Intensidad de sharpen"
                },
                "grain_intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Intensidad de grain"
                },
                "pan_x": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "description": "Posición X de pan"
                },
                "pan_y": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100,
                  "description": "Posición Y de pan"
                }
              },
              "additionalProperties": false,
              "required": ["voiceId", "audioMastering_base"]
            },
            "scenes_rules": {
              "type": "object",
              "patternProperties": {
                "^(default|GANCHO|VALOR|CTA|CIERRE)$": {
                  "$ref": "#/$defs/SceneRule"
                }
              },
              "required": ["default", "GANCHO", "VALOR", "CTA", "CIERRE"]
            }
          },
          "required": ["resolution", "global_fx", "scenes_rules"]
        }
      }
    },
    "default_blueprint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "adnId": {
          "type": "string"
        },
        "slices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "segment_label": {
                "type": "string",
                "enum": ["GANCHO", "VALOR", "VALOR_CONT", "CTA", "CIERRE"]
              },
              "text": {
                "type": "string"
              },
              "voiceover": {
                "type": "string"
              },
              "watermark": {
                "type": "string"
              },
              "imageUrl": {
                "type": "string"
              },
              "duration": {
                "type": "number",
                "minimum": 1,
                "maximum": 60
              },
              "render_config": {
                "type": "object",
                "properties": {
                  "text_styling": {
                    "type": "object",
                    "properties": {
                      "fontName": {
                        "type": "string"
                      },
                      "fontSize": {
                        "type": "number"
                      },
                      "primaryColor": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "alignment": {
                        "type": "string",
                        "enum": ["left", "center", "right"]
                      },
                      "uppercase": {
                        "type": "boolean"
                      },
                      "animation": {
                        "type": "string",
                        "enum": ["pop", "fade_in", "slide_in", "bounce", "kinetic_pop"]
                      }
                    },
                    "additionalProperties": false
                  },
                  "visual_effects": {
                    "type": "object",
                    "properties": {
                      "vignette_intensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "sharpen_intensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "grain_intensity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "colorGrade_lut": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "camera_movement": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string"
                      },
                      "zoom_intensity": {
                        "type": "number"
                      },
                      "zoom_speed": {
                        "type": "number"
                      },
                      "direction": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "ffmpeg_params": {
                "type": "object",
                "properties": {
                  "video_filters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "params": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": ["name", "params"]
                    }
                  },
                  "audio_filters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "params": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": ["name", "params"]
                    }
                  },
                  "output_format": {
                    "type": "object",
                    "properties": {
                      "resolution": {
                        "type": "string",
                        "pattern": "^\\d+x\\d+$"
                      },
                      "fps": {
                        "type": "number",
                        "minimum": 24,
                        "maximum": 60
                      },
                      "codec": {
                        "type": "string"
                      },
                      "audio_codec": {
                        "type": "string"
                      },
                      "bitrate": {
                        "type": "string",
                        "pattern": "^\\d+k$"
                      }
                    },
                    "required": ["resolution", "fps", "codec", "audio_codec", "bitrate"]
                  }
                },
                "additionalProperties": false
              },
              "ai_prompts": {
                "type": "object",
                "properties": {
                  "image_generation": {
                    "type": "object",
                    "properties": {
                      "prompt": {
                        "type": "string"
                      },
                      "style": {
                        "type": "string"
                      },
                      "aspect_ratio": {
                        "type": "string"
                      },
                      "quality": {
                        "type": "string",
                        "enum": ["low", "medium", "high"]
                      }
                    },
                    "required": ["prompt", "style", "aspect_ratio", "quality"]
                  },
                  "text_generation": {
                    "type": "object",
                    "properties": {
                      "prompt_template": {
                        "type": "string"
                      },
                      "tone": {
                        "type": "string"
                      },
                      "style": {
                        "type": "string"
                      },
                      "length": {
                        "type": "string",
                        "enum": ["short", "medium", "long"]
                      }
                    },
                    "required": ["prompt_template", "tone", "style", "length"]
                  },
                  "voice_generation": {
                    "type": "object",
                    "properties": {
                      "voice_id": {
                        "type": "string"
                      },
                      "style": {
                        "type": "string"
                      },
                      "tempo": {
                        "type": "string"
                      },
                      "emotion": {
                        "type": "string"
                      }
                    },
                    "required": ["voice_id", "style", "tempo", "emotion"]
                  }
                },
                "additionalProperties": false
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "segment_type": {
                    "type": "string"
                  },
                  "emotional_tone": {
                    "type": "string"
                  },
                  "visual_intensity": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "audio_intensity": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                  },
                  "target_audience": {
                    "type": "string"
                  },
                  "content_category": {
                    "type": "string"
                  }
                }
    },
    "target_format": {
      "type": "string",
      "enum": ["vertical", "portrait", "square", "horizontal"]
    },
    "watermark_config": {
      "type": "object",
      "properties": {
        "position": {
          "type": "string",
          "enum": ["top-left", "top-right", "bottom-left", "bottom-right", "center"]
        },
        "fontSize": {
          "type": "number",
          "minimum": 12,
          "maximum": 72
        },
        "opacity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "fontFamily": {
          "type": "string",
          "enum": ["Inter-Regular.ttf", "Inter-Bold.ttf", "Inter-Black.ttf", "Roboto-Regular.ttf", "Roboto-Bold.ttf"]
        },
        "animation": {
          "type": "string",
          "enum": ["static", "fade_in", "fade_out", "slide_in", "pulse"]
        }
      },
      "required": ["position", "fontSize", "opacity", "color", "fontFamily", "animation"],
      "additionalProperties": false
    },
    "engine_requirements": {
      "type": "object",
      "properties": {
        "ffmpeg_build": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["ffmpeg_build", "features"],
      "additionalProperties": false
    },
    "global_visual_fx": {
      "type": "object",
      "properties": {
        "voice_id": {
          "type": "string"
        },
        "lut3d": {
          "type": "string"
        },
        "curves_preset": {
          "type": "string",
          "enum": ["none", "color_negative", "cross_process", "older", "vintage", "luma", "chroma", "vibrant", "skin_tones", "cool", "warm"]
        },
        "curves_master": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "global_fx": {
      "type": "object",
      "properties": {
        "voiceId": {
          "type": "string",
          "description": "ID del modelo de voz"
        },
        "audioMastering_base": {
          "type": "string",
          "description": "Base de audio mastering"
        },
        "lut3d": {
          "type": "string",
          "description": "LUT de color grading"
        },
        "curves_preset": {
          "type": "string",
          "enum": ["none", "color_negative", "cross_process", "older", "vintage", "luma", "chroma", "vibrant", "skin_tones", "cool", "warm"],
          "description": "Preset de curves para color grading"
        },
        "curves_master": {
          "type": "string",
          "description": "Curva master personalizada (ej: '0/0 0.5/0.5 1/1')"
        },
        "curves_red": {
          "type": "string",
          "description": "Curva roja personalizada"
        },
        "curves_green": {
          "type": "string",
          "description": "Curva verde personalizada"
        },
        "curves_blue": {
          "type": "string",
          "description": "Curva azul personalizada"
        },
        "vignette_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Intensidad de viñeta"
        },
        "sharpen": {
          "type": "boolean",
          "description": "Aplicar sharpen"
        },
        "safe_area_protection": {
          "type": "boolean",
          "description": "Proteger áreas seguras"
        },
        "platform_target": {
          "type": "string",
          "enum": ["youtube", "instagram", "tiktok", "youtube_shorts"],
          "description": "Plataforma objetivo"
        },
        "zoom_intensity": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3.0,
          "description": "Intensidad de zoom"
        },
        "zoom_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 5.0,
          "description": "Velocidad de zoom"
        },
        "zoom_direction": {
          "type": "string",
          "enum": ["center", "left", "right", "up", "down"],
          "description": "Dirección del zoom"
        },
        "sharpen_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Intensidad de sharpen"
        },
        "grain_intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Intensidad de grain"
        },
        "pan_x": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "description": "Posición X de pan"
        },
        "pan_y": {
          "type": "number",
          "minimum": -100,
          "maximum": 100,
          "description": "Posición Y de pan"
        }
      },
      "additionalProperties": false,
      "required": ["voiceId", "audioMastering_base"],
      "description": "Configuración global de efectos. Los parámetros FFmpeg van en blueprint slices, no aquí."
    }
  },
  "required": ["id", "version", "name", "description"],
  "additionalProperties": false,
  "$defs": {
    "SceneRule": {
      "type": "object",
      "properties": {
        "text_styling": {
          "type": "object",
          "properties": {
            "fontFamily": {
              "type": "string",
              "pattern": "^[^\\s]+\\.(ttf|otf)$"
            },
            "fontSize": {
              "type": "number",
              "minimum": 10,
              "maximum": 200
            },
            "primaryColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "alignment": {
              "type": "string",
              "enum": ["left", "center", "right"]
            },
            "uppercase": {
              "type": "boolean"
            },
            "animation": {
              "type": "string",
              "enum": ["pop", "fade_in", "slide_in", "bounce", "kinetic_pop"]
            },
            "x": {
              "type": ["string", "number"]
            },
            "y": {
              "type": ["string", "number"]
            }
          },
          "additionalProperties": false,
          "required": ["fontFamily", "fontSize", "primaryColor", "alignment"]
        },
        "visual_effects": {
          "type": "object",
          "properties": {
            "vignette_intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sharpen_intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "grain_intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "camera_movement": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["static", "cinematic_zoom", "rapid_zoom", "slow_pan", "pan_left", "zoom_out"]
            },
            "zoom_intensity": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 3.0
            },
            "zoom_speed": {
              "type": "number",
              "minimum": 0,
              "maximum": 5.0
            },
            "direction": {
              "type": "string",
              "enum": ["center", "left", "right", "up", "down"]
            }
          },
          "additionalProperties": false,
          "required": ["mode"]
        }
      },
      "additionalProperties": false,
      "required": ["text_styling"]
    }
  }
}
