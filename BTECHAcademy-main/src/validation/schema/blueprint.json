{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ADN Slices Logic Module",
  "type": "object",
  "required": ["slices"],
  "properties": {
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "segment_label", "text", "duration"],
        "properties": {
          "id": { "type": "string" },
          "segment_label": { "type": "string" },
          "text": { "type": "string" },
          "subtitle": { "type": "string" },
          "voiceover": { "type": "string" },
          "watermark": { "type": "string" },
          "duration": { "type": "number" },
          "imageUrl": { "type": "string" }
        }
      }
    }
  }
}
